{
    "name": "koh/sylius-api-catalog",
    "description": "RFC 9727 API catalog at /.well-known/api-catalog plus the matching Link response headers.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "api-catalog",
        "rfc9727",
        "linkset",
        "link-header",
        "agent"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://github.com/ohartwig/sylius-api-catalog",
    "support": {
        "issues": "https://github.com/ohartwig/sylius-api-catalog/issues",
        "source": "https://github.com/ohartwig/sylius-api-catalog"
    },
    "require": {
        "koh/sylius-agent-contracts": "^1.1",
        "php": "^8.5.11",
        "psr/cache": "^3.0.0",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/web-link": "^7.4 || ^8.0"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.17",
        "phpunit/phpunit": "^11.5.56",
        "symfony/cache": "^7.4.20"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusApiCatalog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusApiCatalog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
